(defcfg
    process-unmapped-keys yes
)

(defalias
    lspe (tap-hold-press 200 200 esc (layer-while-held special))
    scsaa M-C-S-A-a
    scsas M-C-S-A-s
)

(defsrc
    caps
    ret
    spc
    1     2     3     4     5     6     7     8     9     0
    q     w     e     r     t     y     u     i     o     p     [     ]     \
    a     s     d     f     g     h     j     k     l     ;     '
    z     x     c     v     b     n     m     ,     .     /
)

(deflayer main
    @lspe
    ret
    spc
    1     2     3     4     5     6     7     8     9     0
    q     w     e     r     t     y     u     i     o     p     [     ]     \
    a     s     d     f     g     h     j     k     l     ;     '
    z     x     c     v     b     n     m     ,     .     /
)

;; Caps+у/к/г/х type ў қ ғ ҳ in ru_uz (add Shift for capitals): Right Alt is
;; AltGr there. In the us layout Right Alt is plain Alt, so they send Alt+E/R/U/[.
;; Caps+L reloads this config.
(deflayer special
    _
    _
    _
    _     _     _     _     _     _     _     _     _     _
    esc   _     RA-e  RA-r  _     _     RA-u  _     _     _     RA-[  _     _
    @scsaa @scsas _     _     _     _     _     _     lrld  _     _
    _     _     _     _     _     _     _     _     _     _
)
