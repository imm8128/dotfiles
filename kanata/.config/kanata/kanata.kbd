(defcfg
    process-unmapped-keys yes
)

(defalias
    lspe (layer-while-held special)
    scsaa M-C-S-A-a
    scsas M-C-S-A-s
    scsad M-C-S-A-d
    scsaf M-C-S-A-f
)

(defsrc
    caps
    ret
    spc
    1     2     3     4     5     6     7     8     9     0
    q     w     e     r     t     y     u     i     o     p     [     ]     \
    a     s     d     f     g     h     j     k     l     ;     '
    z     x     c     v     b     n     m     ,     .     /
)

(deflayer main
    @lspe
    ret
    spc
    1     2     3     4     5     6     7     8     9     0
    q     w     e     r     t     y     u     i     o     p     [     ]     \
    a     s     d     f     g     h     j     k     l     ;     '
    z     x     c     v     b     n     m     ,     .     /
)

(deflayer special
    _
    _
    _
    _     _     _     _     _     _     _     _     _     _
    esc   _     C-spc lrld  _     _     _     _     _     _     _     _     _
    @scsaa @scsas @scsad _  _     _     _     _     _     _     _
    _     _     _     _     _     _     _     _     _     _
)
