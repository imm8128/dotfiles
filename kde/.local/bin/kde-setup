#!/bin/bash
# Apply KDE Plasma settings that live in state files rather than clean config:
# the Breeze Dark theme, default terminal, file dialog view, taskbar apps with
# Meta+1..9, windows maximized by default except a floating KCalc, the
# half-screen split as the only tiling layout, and keyboard input. Safe to re-run.
set -euo pipefail

# Pinned taskbar apps, in order. Meta+1 activates the first one and launches it
# if it isn't running.
LAUNCHERS=(
    Alacritty.desktop
    brave-browser.desktop
    org.telegram.desktop.desktop
    org.kde.okular.desktop
    libreoffice-calc.desktop
    org.keepassxc.KeePassXC.desktop
    org.kde.kcalc.desktop
)

# Qt key codes for kglobalaccel.
META=$((0x10000000))
KEY_M=$((0x4D))
KEY_PGUP=$((0x01000016))

set_shortcut() {  # component, action, key codes...
    local keys=""
    for k in "${@:3}"; do keys+="([$k, 0, 0, 0],), "; done
    gdbus call --session --dest org.kde.kglobalaccel --object-path /kglobalaccel \
        --method org.kde.KGlobalAccel.setForeignShortcutKeys \
        "['$1', '$2', '', '']" "@a(ai) [${keys%, }]" >/dev/null
}

# Global theme: Breeze Dark (colors, window decorations, icons, cursor). Leaves
# the panel and desktop layout alone.
plasma-apply-lookandfeel --apply org.kde.breezedark.desktop >/dev/null

# Default terminal, used by Dolphin's "Open Terminal" and other KDE apps.
kwriteconfig6 --file kdeglobals --group General --key TerminalApplication alacritty
kwriteconfig6 --file kdeglobals --group General --key TerminalService Alacritty.desktop

# Open/save dialogs show hidden files in the detailed tree view.
kwriteconfig6 --file kdeglobals --group "KFileDialog Settings" --key "Show hidden files" true
kwriteconfig6 --file kdeglobals --group "KFileDialog Settings" --key "View Style" DetailTree

# Taskbar launchers.
js_list=$(printf '"applications:%s",' "${LAUNCHERS[@]}")
qdbus6 org.kde.plasmashell /PlasmaShell org.kde.PlasmaShell.evaluateScript "
    panels().forEach(p => p.widgets('org.kde.plasma.icontasks').forEach(w => {
        w.currentConfigGroup = ['General'];
        w.writeConfig('launchers', [${js_list%,}]);
        w.reloadConfig();
    }));
" >/dev/null

# Meta+1..9 activate taskbar entries.
for i in {1..9}; do
    set_shortcut plasmashell "activate task manager entry $i" $((META + 0x30 + i))
done

# Two layouts only: Meta+M (and the default Meta+PgUp) maximizes, Meta+Left/Right
# tile to halves (KDE default). Top/bottom tiling is unbound, so Meta+Up and
# Meta+Down do nothing.
set_shortcut kwin "Window Maximize" $((META + KEY_M)) $((META + KEY_PGUP))
set_shortcut kwin "Window Quick Tile Top"
set_shortcut kwin "Window Quick Tile Bottom"

# Input: us, ru and uz layouts, and NumLock on at login (0 = on, 1 = off,
# 2 = leave unchanged).
kwriteconfig6 --file kxkbrc --group Layout --key Use true
kwriteconfig6 --file kxkbrc --group Layout --key LayoutList us,ru,uz
kwriteconfig6 --file kcminputrc --group Keyboard --key NumLock 0

# Keyboard layouts: Meta+Space cycles, Meta+Ctrl+Alt+Shift+A/S/D pick one directly.
# KWin only binds a per-layout action that already exists in kglobalaccel, and on
# a fresh config only the keyboard settings page creates them, so register them
# here before reloading the layouts.
HYPER=$((META + 0x04000000 + 0x08000000 + 0x02000000))
layouts="KDE Keyboard Layout Switcher"
set_shortcut "$layouts" "Switch to Next Keyboard Layout" $((META + 0x20))
set_layout_shortcut() {  # layout name, key code
    local action="Switch keyboard layout to $1"
    gdbus call --session --dest org.kde.kglobalaccel --object-path /kglobalaccel \
        --method org.kde.KGlobalAccel.doRegister \
        "['$layouts', '$action', 'Keyboard Layout Switcher', '$action']" >/dev/null
    set_shortcut "$layouts" "$action" "$2"
}
set_layout_shortcut "English (US)" $((HYPER + 0x41))
set_layout_shortcut Russian $((HYPER + 0x53))
set_layout_shortcut Uzbek $((HYPER + 0x44))
# KWin reloads layouts on KConfig's change signal. kwriteconfig6 --notify skips
# it when the value is unchanged, so send it directly.
gdbus emit --session --object-path /kxkbrc --signal org.kde.kconfig.notify.ConfigChanged \
    "{'Layout': [b'LayoutList']}"

# Window rules. For each property KWin uses the first matching rule in the list,
# so exceptions go before the catch-all. Rules added in System Settings stay
# ahead of these.
set_rule() {  # rule, key=value...
    for kv in "${@:2}"; do
        kwriteconfig6 --file kwinrulesrc --group "$1" --key "${kv%%=*}" "${kv#*=}"
    done
}

# KCalc opens floating: normal size, centered on the screen. Placement 5 is
# Centered, rule 2 forces it and 3 applies it once.
set_rule kcalc-floating Description="KCalc floating" \
    wmclass=org.kde.kcalc wmclassmatch=1 \
    maximizehoriz=false maximizehorizrule=3 maximizevert=false maximizevertrule=3 \
    placement=5 placementrule=2

# New normal windows open maximized. Dialogs keep their own size.
set_rule maximize-by-default Description="Maximize new windows" types=1 \
    maximizehoriz=true maximizehorizrule=3 maximizevert=true maximizevertrule=3

own_rules=(kcalc-floating maximize-by-default)
IFS=, read -ra existing <<<"$(kreadconfig6 --file kwinrulesrc --group General --key rules)"
rules=()
for r in "${existing[@]}"; do
    [[ " ${own_rules[*]} " == *" $r "* ]] || rules+=("$r")
done
rules+=("${own_rules[@]}")
kwriteconfig6 --file kwinrulesrc --group General --key rules "$(IFS=,; echo "${rules[*]}")"
kwriteconfig6 --file kwinrulesrc --group General --key count "${#rules[@]}"

# Custom tile layout (Meta+T, Shift+drag) is the same 50/50 split on every
# screen and desktop. Set through a KWin script so it applies now, and KWin
# saves it to kwinrc itself.
tiles_js=$(mktemp --suffix=.js)
trap 'rm -f "$tiles_js"' EXIT
cat >"$tiles_js" <<'EOF'
for (const output of workspace.screens) {
    for (const desktop of workspace.desktops) {
        const root = workspace.rootTile(output, desktop);
        while (root.tiles.length > 2) root.tiles[root.tiles.length - 1].remove();
        while (root.tiles.length < 2) root.split(1);
        root.tiles[0].relativeGeometry = {x: 0, y: 0, width: 0.5, height: 1};
    }
}
EOF
id=$(qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.loadScript "$tiles_js" kde-setup-tiles)
qdbus6 org.kde.KWin "/Scripting/Script$id" org.kde.kwin.Script.run
sleep 1
qdbus6 org.kde.KWin /Scripting org.kde.kwin.Scripting.unloadScript kde-setup-tiles >/dev/null

qdbus6 org.kde.KWin /KWin reconfigure
